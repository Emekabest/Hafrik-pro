{
  "expo": {
    "name": "Hafrik Pro",
    "slug": "hafrik",
    "version": "1.0.0",
    "icon": "./src/assl.js/icon.png",
    "android": {
      "package": "com.jojo104.hafrik",
      "icon": "./src/assl.js/icon.png"
    },
    "ios": {
      "bundleIdentifier": "com.jojo104.hafrikpro",
      "icon": "./src/assl.js/icon.png",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ],
        "AVAudioSessionCategory": "ambient",
        "AVAudioSessionCategoryOptions": [
          "mixWithOthers"
        ]
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "baed6d6b-0b66-486e-aec9-01d4af7e0947"
      }
    }
  }
}
