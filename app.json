{
  "expo": {
    "name": "Hafrik Pro",
    "slug": "hafrikpro",
    "version": "1.0.0",
    "icon": "./src/assl.js/icon.png",
    "android": {
      "package": "com.hafrik.app",
"icon": "./src/assl.js/icon.png"
    },
    "ios": {
      "bundleIdentifier": "com.hafrik.hafrikpro",
      "icon": "./src/assl.js/icon.png",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ],
        "AVAudioSessionCategory": "ambient",
        "AVAudioSessionCategoryOptions": [
          "mixWithOthers"
        ]
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/assl.js/icon.png",
          "color": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f31bc39b-255b-4ca9-933a-43630bf6b195"
      }
    },
    "owner": "horlaarsman"
  }
}
